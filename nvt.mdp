title           = NVT equilibration
define          = -DPOSRES         ; position restraints on protein
integrator      = md
dt              = 0.002
nsteps          = 8000           ; 100 ps
nstxout         = 1000
nstvout         = 1000
nstenergy       = 500
nstlog          = 500
continuation    = no
constraints     = h-bonds
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype = cut-off
rcoulomb = 1.0
vdwtype = cut-off
rvdw = 1.0
pbc             = xyz

tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau_t           = 0.1   0.1
ref_t           = 310   310




