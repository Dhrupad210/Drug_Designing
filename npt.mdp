; NPT equilibration – corrected
title           = NPT equilibration (safe)
define          = -DPOSRES           ; position restraints on protein
integrator      = md
dt              = 0.002              ; 2 fs
nsteps          = 25000              ; 50 ps
nstxout         = 1000
nstvout         = 1000
nstenergy       = 500
nstlog          = 500
continuation    = yes
constraints     = h-bonds
constraint_algorithm = lincs
lincs_iter      = 1
lincs_order     = 6
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = cut-off
rvdw            = 1.0
pbc             = xyz

; Temperature coupling
tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau_t           = 0.1   0.1
ref_t           = 310   310

; Pressure coupling – start gentle with Berendsen
pcoupl          = Berendsen
pcoupltype      = isotropic
tau_p           = 1.0
ref_p           = 1.0
compressibility = 4.5e-5

; Prevent artifacts with restrained protein
refcoord_scaling = com

